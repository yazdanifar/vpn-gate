<Project Sdk="Microsoft.NET.Sdk">
  <!--
    In-process WinUI tests (U34). xUnit v3 test projects are executables, so this one is a self-contained unpackaged WinUI app
    like VPNGate.App: it starts a XAML Application on its own UI thread and every test runs there. The views are compiled in from
    VPNGate.App as links (everything except App.xaml). Windows only: dotnet build -p:Platform=x64, then run the .exe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VPNGate.App</RootNamespace>
    <AssemblyName>VPNGate.UiTests</AssemblyName>
    <ApplicationManifest>..\VPNGate.App\app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
  </ItemGroup>
  <!-- The app's views and their helpers, with App.xaml (its OnLaunched does nothing under VPNGATE_UITEST). -->
  <ItemGroup>
    <Compile Include="..\VPNGate.App\*.cs" LinkBase="App" />
    <ApplicationDefinition Include="..\VPNGate.App\App.xaml" Link="App.xaml" />
    <Page Include="..\VPNGate.App\MainWindow.xaml" Link="MainWindow.xaml" />
    <Page Include="..\VPNGate.App\LogWindow.xaml" Link="LogWindow.xaml" />
    <Compile Include="..\VPNGate.Tests\FakeDaemon.cs" Link="FakeDaemon.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\VPNGate.App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VPNGate.Core\VPNGate.Core.csproj" />
  </ItemGroup>
</Project>
